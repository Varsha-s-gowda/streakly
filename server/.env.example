# Server port
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/streakly

# Use a long, random secret in production (e.g. openssl rand -hex 48)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Where the Vite dev server runs (used for CORS)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development

# The first account can always register. Set to true to allow extra accounts too.
ALLOW_SIGNUP=true
